# EventVerse environment variables
# Copy to .env.local. All values are optional — without Supabase keys the app
# runs entirely in local demo mode (sample data + browser storage).

# Supabase project URL and anon (public) key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public base URL used when generating event QR codes (defaults to window.location.origin)
VITE_PUBLIC_BASE_URL=

# Book-a-Demo lead delivery (FormSubmit AJAX endpoint). Defaults to the owner's inbox.
# After activating FormSubmit, use the random alias it emails you to hide the address:
# VITE_LEADS_ENDPOINT=https://formsubmit.co/ajax/<alias>
VITE_LEADS_ENDPOINT=
